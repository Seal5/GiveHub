{
  "expo": {
    "name": "GiveHub",
    "slug": "givehub",
    "scheme": "givehub",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "nz.co.givehub.app",
      "associatedDomains": ["applinks:givehub.nz", "applinks:www.givehub.nz"]
    },
    "android": {
      "package": "nz.co.givehub.app",
      "adaptiveIcon": {
        "backgroundColor": "#102219"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            { "scheme": "https", "host": "givehub.nz", "pathPrefix": "/o" },
            { "scheme": "https", "host": "www.givehub.nz", "pathPrefix": "/o" }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow GiveHub to find volunteer opportunities near you."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
