# Set true only when you intentionally want the in-memory fixture experience.
EXPO_PUBLIC_DEMO_MODE=false
EXPO_PUBLIC_LOCAL_AUTH=false

# With Android USB port forwarding, use 127.0.0.1. For Wi-Fi, replace it
# with the computer's LAN address, such as http://192.168.1.100:8000.
EXPO_PUBLIC_API_URL=http://127.0.0.1:8000

# Base URL used when sharing an opportunity. Defaults to EXPO_PUBLIC_API_URL,
# which serves the public /o/<id> landing page. Point it at the marketing
# domain configured for universal links once that is live.
EXPO_PUBLIC_SHARE_BASE_URL=https://givehub.nz

EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
EXPO_PUBLIC_SUPABASE_STORAGE_BUCKET=opportunity-images
